ENVIRONMENT=development
# Atlas or a local replica set. Never use an in-memory fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=brandshield
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=brandshield-api
ACCESS_TOKEN_MINUTES=240
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional canonical frontend, added to CORS_ORIGINS without replacing its entries.
# Vercel sets this public value in backend/vercel.json.
# FRONTEND_ORIGIN=https://brandshield-ai-y11i.vercel.app
# Origins must have no path. Set ENVIRONMENT=production in Vercel.
MAX_UPLOAD_BYTES=10485760
GEMINI_API_KEY=
# Configure a currently available Gemini model in your provider account.
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=20
ENABLE_DEMO_SEED=false
# Optional private seed inputs, used only by scripts/seed_demo.py:
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CREATOR_EMAIL=
DEMO_CREATOR_PASSWORD=
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_PASSWORD=
